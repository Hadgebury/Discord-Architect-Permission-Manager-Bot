# Ignore Python cache
__pycache__/
*.py[cod]
*$py.class

# Configuration & Secrets (Do NOT commit your token)
config.json
.env
config.py

# Generated Channel & Global Permissions Backups/Configs
backup_channels.json
config_channels.json
backup_global.json
config_global.json

# User-specific blueprint outputs in blueprints/ and backups/
backups/*
!backups/.gitkeep
blueprints/*
!blueprints/.gitkeep
!blueprints/starter_community.json

# OS and Editor files
.vscode/
.idea/
*.swp
Thumbs.db